{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "BaseTopic",
            "caption": "Basis-Topic (muss zur Firmware passen)",
            "validate": "^[^#+]+$"
        },
        {
            "type": "NumberSpinner",
            "name": "RepublishInterval",
            "caption": "Alles neu senden alle",
            "suffix": "Sekunden (0 = aus)",
            "minimum": 0
        },
        {
            "type": "ExpansionPanel",
            "caption": "Seiten",
            "items": [
                {
                    "type": "List",
                    "name": "Pages",
                    "caption": "Seiten in Reihenfolge (hoechstens 5, Name etwa bis 10 Zeichen)",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "columns": [
                        { "name": "Name", "caption": "Name", "width": "auto", "add": "", "edit": { "type": "ValidationTextBox" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kacheln",
            "items": [
                {
                    "type": "List",
                    "name": "Tiles",
                    "caption": "Kacheln (leer = Standardwert. Gleicher Key in mehreren Zeilen = Werte verrechnen, die erste Zeile legt Seite, Titel, Einheit, Stellen, Farben und Berechnung fest)",
                    "rowCount": 8,
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "columns": [
                        { "name": "Key", "caption": "Key", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Page", "caption": "Seite", "width": "110px", "add": "Start", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Title", "caption": "Titel", "width": "110px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Unit", "caption": "Einheit", "width": "70px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Decimals", "caption": "Stellen", "width": "70px", "add": "", "edit": { "type": "ValidationTextBox", "validate": "^(-1|[0-6])?$" } },
                        { "name": "VariableID", "caption": "Variable", "width": "auto", "add": 0, "edit": { "type": "SelectVariable" } },
                        { "name": "Factor", "caption": "Faktor", "width": "120px", "add": 1, "edit": { "type": "NumberSpinner", "digits": 4 } },
                        { "name": "Formatted", "caption": "Formatiert", "width": "100px", "add": false, "edit": { "type": "CheckBox" } },
                        {
                            "name": "Operation", "caption": "Berechnung", "width": "130px", "add": "Summe",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    { "caption": "Summe", "value": "Summe" },
                                    { "caption": "Differenz", "value": "Differenz" },
                                    { "caption": "Mittelwert", "value": "Mittelwert" },
                                    { "caption": "Minimum", "value": "Minimum" },
                                    { "caption": "Maximum", "value": "Maximum" }
                                ]
                            }
                        },
                        { "name": "Colors", "caption": "Farben", "width": "220px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        {
                            "name": "Size", "caption": "Groesse", "width": "90px", "add": "1x1",
                            "edit": { "type": "Select", "options": [
                                { "caption": "1x1", "value": "1x1" }, { "caption": "2x1", "value": "2x1" }, { "caption": "2x2", "value": "2x2" },
                                { "caption": "4x1", "value": "4x1" }, { "caption": "4x2", "value": "4x2" }, { "caption": "4x3 (ganze Seite)", "value": "4x3" } ] }
                        },
                        {
                            "name": "Display", "caption": "Darstellung", "width": "130px", "add": "",
                            "edit": { "type": "Select", "options": [
                                { "caption": "Standard", "value": "" }, { "caption": "Zahl", "value": "Zahl" },
                                { "caption": "Rundanzeige", "value": "Rundanzeige" }, { "caption": "Balken", "value": "Balken" }, { "caption": "Energiefluss", "value": "Energiefluss" } ] }
                        },
                        { "name": "Max", "caption": "Maximum", "width": "90px", "add": "", "edit": { "type": "ValidationTextBox", "validate": "^(\\d+(\\.\\d+)?)?$" } },
                        {
                            "name": "Column", "caption": "Spalte", "width": "80px", "add": "",
                            "edit": { "type": "Select", "options": [
                                { "caption": "auto", "value": "" }, { "caption": "1", "value": "1" }, { "caption": "2", "value": "2" },
                                { "caption": "3", "value": "3" }, { "caption": "4", "value": "4" } ] }
                        },
                        {
                            "name": "Row", "caption": "Zeile", "width": "80px", "add": "",
                            "edit": { "type": "Select", "options": [
                                { "caption": "auto", "value": "" }, { "caption": "1", "value": "1" }, { "caption": "2", "value": "2" },
                                { "caption": "3", "value": "3" } ] }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Buttons",
            "items": [
                {
                    "type": "List",
                    "name": "Buttons",
                    "caption": "Buttons und Dimmer (Button: Bool-Variable wird umgeschaltet, Dimmer: Regler 0-100 % ueber den Bereich des Variablenprofils, Skript wird ausgefuehrt)",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "columns": [
                        { "name": "Key", "caption": "Key", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Page", "caption": "Seite", "width": "110px", "add": "Start", "edit": { "type": "ValidationTextBox" } },
                        {
                            "name": "Type", "caption": "Typ", "width": "100px", "add": "Button",
                            "edit": { "type": "Select", "options": [ { "caption": "Button", "value": "Button" }, { "caption": "Dimmer", "value": "Dimmer" } ] }
                        },
                        { "name": "Label", "caption": "Beschriftung", "width": "150px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "VariableID", "caption": "Variable", "width": "auto", "add": 0, "edit": { "type": "SelectVariable" } },
                        { "name": "ScriptID", "caption": "Skript", "width": "300px", "add": 0, "edit": { "type": "SelectScript" } },
                        {
                            "name": "Size", "caption": "Groesse", "width": "90px", "add": "1x1",
                            "edit": { "type": "Select", "options": [
                                { "caption": "1x1", "value": "1x1" }, { "caption": "2x1", "value": "2x1" }, { "caption": "2x2", "value": "2x2" },
                                { "caption": "4x1", "value": "4x1" }, { "caption": "4x2", "value": "4x2" }, { "caption": "4x3 (ganze Seite)", "value": "4x3" } ] }
                        },
                        {
                            "name": "Column", "caption": "Spalte", "width": "80px", "add": "",
                            "edit": { "type": "Select", "options": [
                                { "caption": "auto", "value": "" }, { "caption": "1", "value": "1" }, { "caption": "2", "value": "2" },
                                { "caption": "3", "value": "3" }, { "caption": "4", "value": "4" } ] }
                        },
                        {
                            "name": "Row", "caption": "Zeile", "width": "80px", "add": "",
                            "edit": { "type": "Select", "options": [
                                { "caption": "auto", "value": "" }, { "caption": "1", "value": "1" }, { "caption": "2", "value": "2" },
                                { "caption": "3", "value": "3" } ] }
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Alle Werte jetzt senden",
            "onClick": "CKD_PublishAll($id);"
        }
    ]
}
