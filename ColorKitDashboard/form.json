{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "BaseTopic",
            "caption": "Basis-Topic (muss zur Firmware passen)",
            "validate": "^[^#+]+$"
        },
        {
            "type": "NumberSpinner",
            "name": "RepublishInterval",
            "caption": "Alles neu senden alle",
            "suffix": "Sekunden (0 = aus)",
            "minimum": 0
        },
        {
            "type": "ExpansionPanel",
            "caption": "Seiten",
            "items": [
                {
                    "type": "List",
                    "name": "Pages",
                    "caption": "Seiten in Reihenfolge (hoechstens 5, Name etwa bis 10 Zeichen, ohne Umlaute)",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "columns": [
                        { "name": "Name", "caption": "Name", "width": "auto", "add": "", "edit": { "type": "ValidationTextBox" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kacheln",
            "items": [
                {
                    "type": "List",
                    "name": "Tiles",
                    "caption": "Kacheln (leer = Standardwert. Gleicher Key in mehreren Zeilen = Werte verrechnen, die erste Zeile legt Seite, Titel, Einheit, Stellen, Farben und Berechnung fest)",
                    "rowCount": 8,
                    "add": true,
                    "delete": true,
                    "columns": [
                        { "name": "Key", "caption": "Key", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Page", "caption": "Seite", "width": "110px", "add": "Start", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Title", "caption": "Titel", "width": "110px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Unit", "caption": "Einheit", "width": "70px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Decimals", "caption": "Stellen", "width": "70px", "add": "", "edit": { "type": "ValidationTextBox", "validate": "^(-1|[0-6])?$" } },
                        { "name": "VariableID", "caption": "Variable", "width": "auto", "add": 0, "edit": { "type": "SelectVariable" } },
                        { "name": "Factor", "caption": "Faktor", "width": "120px", "add": 1, "edit": { "type": "NumberSpinner", "digits": 4 } },
                        { "name": "Formatted", "caption": "Formatiert", "width": "100px", "add": false, "edit": { "type": "CheckBox" } },
                        {
                            "name": "Operation", "caption": "Berechnung", "width": "130px", "add": "Summe",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    { "caption": "Summe", "value": "Summe" },
                                    { "caption": "Differenz", "value": "Differenz" },
                                    { "caption": "Mittelwert", "value": "Mittelwert" },
                                    { "caption": "Minimum", "value": "Minimum" },
                                    { "caption": "Maximum", "value": "Maximum" }
                                ]
                            }
                        },
                        { "name": "Colors", "caption": "Farben", "width": "220px", "add": "", "edit": { "type": "ValidationTextBox" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Buttons",
            "items": [
                {
                    "type": "List",
                    "name": "Buttons",
                    "caption": "Buttons (Bool-Variable wird umgeschaltet, Skript wird ausgefuehrt)",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "columns": [
                        { "name": "Key", "caption": "Key", "width": "200px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Page", "caption": "Seite", "width": "110px", "add": "Start", "edit": { "type": "ValidationTextBox" } },
                        { "name": "Label", "caption": "Beschriftung", "width": "150px", "add": "", "edit": { "type": "ValidationTextBox" } },
                        { "name": "VariableID", "caption": "Variable", "width": "auto", "add": 0, "edit": { "type": "SelectVariable" } },
                        { "name": "ScriptID", "caption": "Skript", "width": "300px", "add": 0, "edit": { "type": "SelectScript" } }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Alle Werte jetzt senden",
            "onClick": "CKD_PublishAll($id);"
        }
    ]
}
